#!/bin/bash
# Runtime PCIe configuration for safe OCuLink hot-removal
# No bootloader changes needed!

LOG="/var/log/oculink-kernel-config.log"

OCULINK_LIB="$(dirname -- "$(readlink -f -- "$0")")/oculink-common.sh"
[ -r "$OCULINK_LIB" ] || OCULINK_LIB=/usr/local/lib/oculink/oculink-common.sh
source "$OCULINK_LIB" || exit 1

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG"
}

log_msg "Configuring PCIe for OCuLink hot-plug safety..."

# Find discrete GPU (full address, e.g. 0000:c6:00.0)
GPU_PCI=$(find_oculink_gpus | head -1)
if [ -z "$GPU_PCI" ]; then
    log_msg "No discrete GPU found at boot - will configure when connected"
    exit 0
fi

log_msg "Found discrete GPU at: $GPU_PCI"

# Runtime parameters via sysfs
configure_pcie_hotplug() {
    local pci_addr="$1"

    if [ -d "/sys/bus/pci/devices/$pci_addr" ]; then
        # Set power control to auto (allows runtime PM)
        echo "auto" > "/sys/bus/pci/devices/$pci_addr/power/control" 2>/dev/null || true

        # Enable D3cold for better power management
        echo "1" > "/sys/bus/pci/devices/$pci_addr/d3cold_allowed" 2>/dev/null || true

        log_msg "Configured PCIe device $pci_addr for hot-removal"
    fi
}

configure_pcie_hotplug "$GPU_PCI"

# AMDGPU module parameters (gpu_recovery, runpm, lockup_timeout) are read-only
# at runtime, so they can only be set on the kernel command line or in
# /etc/modprobe.d, e.g.:
#   options amdgpu gpu_recovery=1
if [ -r /sys/module/amdgpu/parameters/gpu_recovery ]; then
    log_msg "amdgpu gpu_recovery=$(cat /sys/module/amdgpu/parameters/gpu_recovery)"
fi

log_msg "OCuLink PCIe configuration complete!"
