#!/bin/bash
# OCuLink GPU Watcher - Monitors the kernel log for errors from the OCuLink GPU
#
# Only notifies: the GPU is often still usable after an error, and removing it
# automatically would close everything running on it.

LOGFILE="/var/log/oculink-gpu-watcher.log"
NOTIFY_INTERVAL=60  # at most one notification per minute

OCULINK_LIB="$(dirname -- "$(readlink -f -- "$0")")/oculink-common.sh"
[ -r "$OCULINK_LIB" ] || OCULINK_LIB=/usr/local/lib/oculink/oculink-common.sh
source "$OCULINK_LIB" || exit 1

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOGFILE"
}

log_message "OCuLink GPU Watcher started, current GPUs: $(find_oculink_gpus | tr '\n' ' ')"

last_notified=0
journalctl -k -f -n 0 -o cat | while read -r line; do
    [[ "${line,,}" == *error* || "${line,,}" == *timeout* ]] || continue

    # Only care about messages from the OCuLink GPU itself (drivers prefix
    # messages with the device's PCI address); looked up each time since it
    # comes and goes
    for addr in $(find_oculink_gpus); do
        [[ "$line" == *"$addr"* ]] || continue

        log_message "GPU error: $line"
        now=$(date +%s)
        if [ $((now - last_notified)) -ge $NOTIFY_INTERVAL ]; then
            notify_user "OCuLink GPU Error" "${line:0:200}" "critical" "OCuLink GPU Watcher"
            last_notified=$now
        fi
        break
    done
done
