#!/bin/bash
# Smart OCuLink GPU Reconnection Monitor
# Only activates after a removal event, intelligently detects reconnection
#
# OCuLink has no hotplug signalling, so plugging the GPU back in doesn't
# generate any events. Instead, watch the link on the port it was removed
# from, and rescan that port once the link comes back up.

MONITOR_STATE_FILE="/run/oculink/monitor-state"
RECONNECT_TIMEOUT=600  # 10 minutes
LOG_FILE="/var/log/oculink-reconnect.log"

OCULINK_LIB="$(dirname -- "$(readlink -f -- "$0")")/oculink-common.sh"
[ -r "$OCULINK_LIB" ] || OCULINK_LIB=/usr/local/lib/oculink/oculink-common.sh
source "$OCULINK_LIB" || exit 1

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

send_notification() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"

    notify_user "$title" "$message" "$urgency" "OCuLink Monitor"
    log_message "NOTIFICATION: $title - $message"
}

# Launch the monitor as its own systemd unit so it outlives whoever started it
start_monitoring() {
    local removed_gpu_model="$1"
    local port="$2"

    log_message "Starting smart reconnection monitoring for: $removed_gpu_model (port $port)"
    systemd-run --quiet --collect --unit="$OCULINK_RECONNECT_UNIT" \
        "$OCULINK_BIN_DIR/oculink-reconnect-monitor" run "$removed_gpu_model" "$port"
}

# The monitor itself (runs in the foreground inside the systemd unit)
run_monitor() {
    local target_gpu="$1"
    local port="$2"
    local start_time=$(date +%s)
    local up_count=0

    send_notification "Monitoring Active" "Watching for OCuLink GPU reconnection..." "normal"
    echo "ACTIVE|$target_gpu|$start_time" > "$MONITOR_STATE_FILE"
    trap 'rm -f "$MONITOR_STATE_FILE"' EXIT

    while true; do
        # Require two readings in a row so the link has finished training
        if oculink_link_up "$port"; then
            up_count=$((up_count + 1))
        else
            up_count=0
        fi

        if [ "$up_count" -ge 2 ]; then
            log_message "Link up on $port - rescanning"
            oculink_rescan

            local new_gpu=$(list_oculink_gpus | grep -F -- "$target_gpu" | head -1)
            if [ -n "$new_gpu" ]; then
                log_message "Target GPU reconnected: $new_gpu"
                handle_reconnection "$new_gpu"
                return 0
            fi

            # Link is up but the card isn't answering yet; try again shortly
            log_message "Link up but GPU not found after rescan, retrying"
            up_count=0
        fi

        if [ $(( $(date +%s) - start_time )) -gt $RECONNECT_TIMEOUT ]; then
            log_message "Reconnection monitoring timeout reached"
            send_notification "Monitor Timeout" "Stopped watching for GPU reconnection - run gpu-safe-remove after plugging it in" "normal"
            return 1
        fi

        sleep 2
    done
}

handle_reconnection() {
    local gpu_info="$1"

    log_message "Handling GPU reconnection: $gpu_info"
    send_notification "GPU Detected!" "OCuLink GPU reconnected - initializing..." "normal"

    # Back to normal: restore the port's power management, clear removal state
    oculink_clear_removal_state

    # Load amdgpu driver if needed
    if ! lsmod | grep -q "amdgpu"; then
        log_message "Loading amdgpu driver"
        modprobe amdgpu 2>/dev/null || {
            send_notification "Driver Error" "Failed to load GPU driver" "critical"
            return 1
        }
    fi

    # Give driver time to initialize
    sleep 3

    # Verify GPU is working
    if [ -n "$(lspci -s "${gpu_info%% *}" 2>/dev/null)" ]; then
        send_notification "GPU Ready!" "OCuLink GPU successfully reconnected and ready!" "normal"
        log_message "GPU reconnection completed successfully"

        # Optional: trigger any custom post-reconnection scripts
        local active_user=$(oculink_desktop_user)
        if [ -n "$active_user" ] && [ -x "/home/$active_user/.config/scripts/gpu-reconnected.sh" ]; then
            runuser -u "$active_user" -- "/home/$active_user/.config/scripts/gpu-reconnected.sh"
        fi
    else
        send_notification "Reconnection Failed" "GPU detected but not fully functional" "critical"
    fi
}

# Main execution
case "$1" in
    start)
        if systemctl is-active --quiet "$OCULINK_RECONNECT_UNIT"; then
            log_message "Monitor already active"
            exit 0
        fi
        if [ -z "$3" ]; then
            echo "Usage: $0 start <gpu_model> <pci_port>"
            exit 1
        fi
        start_monitoring "$2" "$3"
        ;;
    run)
        run_monitor "$2" "$3"
        ;;
    stop)
        if systemctl is-active --quiet "$OCULINK_RECONNECT_UNIT"; then
            log_message "Stopping reconnection monitoring"
            systemctl stop "$OCULINK_RECONNECT_UNIT"
        fi
        ;;
    status)
        if systemctl is-active --quiet "$OCULINK_RECONNECT_UNIT" && [ -f "$MONITOR_STATE_FILE" ]; then
            cat "$MONITOR_STATE_FILE"
        else
            echo "INACTIVE"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|status} [gpu_model] [pci_port]"
        exit 1
        ;;
esac
