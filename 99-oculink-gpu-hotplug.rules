# OCuLink GPU Hot-plug Rules
# Matches every display-class (03xxxx) PCI device; oculink-gpu-manager filters
# down to the GPU configured in /etc/oculink-gpu.conf.
#
# OCuLink has no hotplug signalling, so this only fires when the device shows
# up via a PCI rescan (which the reconnect monitor and gpu-safe-remove do).
# Removal is driven by gpu-safe-remove rather than udev.

SUBSYSTEM=="pci", ACTION=="add", ENV{PCI_CLASS}=="3????", RUN+="/usr/local/bin/oculink-gpu-manager add %k"
