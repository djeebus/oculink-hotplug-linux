#!/bin/bash
# OCuLink GPU Toggle Tool - Safe removal and reconnection

# Removing/rescanning PCI devices needs root
if [ "$EUID" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

OCULINK_LIB="$(dirname -- "$(readlink -f -- "$0")")/oculink-common.sh"
[ -r "$OCULINK_LIB" ] || OCULINK_LIB=/usr/local/lib/oculink/oculink-common.sh
source "$OCULINK_LIB" || exit 1

send_notification() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"

    notify_user "$title" "$message" "$urgency"
    echo "🔔 $title: $message"
}

echo "🔌 OCuLink GPU Toggle Tool"
echo "=========================="

# Check monitor status
monitor_status=$("$OCULINK_BIN_DIR/oculink-reconnect-monitor" status 2>/dev/null || echo "INACTIVE")
removal_watcher_active=$(systemctl is-active --quiet "$OCULINK_REMOVAL_UNIT" && echo "ACTIVE" || echo "INACTIVE")

if [[ "$removal_watcher_active" == "ACTIVE" ]]; then
    echo "👀 Stage 1: Waiting for physical GPU removal..."
    echo
elif [[ "$monitor_status" != "INACTIVE" ]]; then
    echo "🔄 Stage 2: Smart reconnection monitoring active"
    echo "   $monitor_status"
    echo
fi

echo

# Check if removal is in progress (GPU detached but still plugged in)
if [ -f "$OCULINK_LOCKFILE" ] || [[ "$removal_watcher_active" == "ACTIVE" ]]; then
    echo "🔄 GPU removal in progress..."
    echo "   GPU should be safe to unplug now!"
    echo
    read -p "📌 Cancel removal and restore GPU? [y/N]: " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        systemctl stop "$OCULINK_REMOVAL_UNIT" 2>/dev/null
        "$OCULINK_BIN_DIR/oculink-reconnect-monitor" stop

        if oculink_rescan; then
            send_notification "Cancelled" "GPU removal cancelled - GPU restored" "normal"
            echo "✅ Removal cancelled and GPU restored."
        else
            send_notification "Cancelled" "GPU removal cancelled, but the GPU did not come back - check connection" "critical"
            echo "⚠️  Removal cancelled, but the GPU did not come back."
        fi
        oculink_clear_removal_state
    fi
    exit 0
fi

# Check if the OCuLink GPU (as defined in the GPU config) is present
discrete_gpu=$(list_oculink_gpus | head -1)

if [ -n "$discrete_gpu" ]; then
    # GPU present - offer removal
    echo "🔍 Detected discrete GPU:"
    echo "   $discrete_gpu"
    echo

    # Show what removal will do to running programs
    stopping=()
    sparing=()
    for pid in $(oculink_gpu_pids "${discrete_gpu%% *}"); do
        comm=$(cat "/proc/$pid/comm" 2>/dev/null) || continue
        if oculink_is_spared "$pid" "$comm"; then
            sparing+=("$comm ($pid)")
        else
            stopping+=("$comm ($pid)")
        fi
    done
    if [ ${#stopping[@]} -gt 0 ]; then
        echo "🛑 These programs are using the GPU and will be closed:"
        printf '   • %s\n' "${stopping[@]}"
        echo
    fi
    if [ ${#sparing[@]} -gt 0 ]; then
        echo "🖥️  These will keep running, but lose access to the GPU (and its displays):"
        printf '   • %s\n' "${sparing[@]}"
        echo
    fi

    read -p "⚠️  Safely prepare GPU for removal? [y/N]: " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "❌ Cancelled."
        exit 0
    fi

    # Removing the GPU with displays attached (especially DP MST hubs and
    # daisy chains) can panic the kernel, so wait for them to be unplugged
    displays=$(oculink_gpu_displays "${discrete_gpu%% *}")
    if [ -n "$displays" ]; then
        echo "🖥️  Unplug these displays from the GPU first (removing the GPU with displays"
        echo "   attached can crash the kernel):"
        printf '   • %s\n' $displays
        echo "   Waiting for them to disconnect... (Ctrl+C to cancel)"
        while [ -n "$(oculink_gpu_displays "${discrete_gpu%% *}")" ]; do
            sleep 1
        done
        echo "✅ Displays disconnected."
        # Let amdgpu finish tearing down the outputs (and any MST topology)
        sleep 2
        echo
    fi

    echo "🔄 Preparing GPU for safe removal..."
    echo "   • Closing programs using the GPU"
    echo "   • Disconnecting PCIe device"
    echo

    # Call the manager script
    if "$OCULINK_BIN_DIR/oculink-gpu-manager" manual-safe-remove; then
        echo "✅ GPU is now safe to unplug!"
        echo "   You'll get a notification once it's unplugged, and again when it's reconnected."
    else
        echo "❌ GPU removal failed - see /var/log/oculink-gpu-manager.log"
        exit 1
    fi

else
    # No discrete GPU - trigger rescan for reconnection
    send_notification "Scanning..." "Looking for reconnected OCuLink GPU"
    echo "🔍 Only integrated GPU detected."
    echo "   Scanning for reconnected OCuLink GPU..."
    echo

    if oculink_rescan; then
        "$OCULINK_BIN_DIR/oculink-reconnect-monitor" stop
        oculink_clear_removal_state

        # Load the driver if needed
        if ! lsmod | grep -q "amdgpu"; then
            echo "🔄 Loading GPU driver..."
            modprobe amdgpu 2>/dev/null || {
                send_notification "Driver Error" "Could not load amdgpu driver" "critical"
                echo "⚠️  Could not load amdgpu driver"
            }
        fi

        echo "✅ OCuLink GPU reconnected!"
        echo "   $(list_oculink_gpus | head -1)"
        send_notification "GPU Ready!" "OCuLink GPU is ready to use!"
    else
        send_notification "GPU Not Found" "No OCuLink GPU detected - check connection" "critical"
        echo "❌ No OCuLink GPU detected."
        echo "   Make sure GPU is properly connected."
    fi
fi
